cat > .gitignore << 'EOF'
# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Environment
.env
.env.*
!.env.example

# DuckDB — never commit the database
warehouse/
*.duckdb
*.duckdb.wal

# ML models — binary files, regenerated by pipeline
ml_models/saved_models/*.pkl
ml_models/saved_models/*.joblib

# Dagster runtime files — only keep dagster.yaml config
.dagster/storage/
.dagster/history/
.dagster/logs/
.dagster/runs/
.dagster/event_logs/
.tmp_dagster_home_*/

# DLT pipeline state
.dlt/
pipeline_state/

# Jupyter — strip outputs before committing
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Docker
*.env.docker
EOF